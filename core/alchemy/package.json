{
  "name": "core-alchemy",
  "type": "module",
  "description": "The Alchemy script that deploys one mind as a stack of Workers",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/**/*.test.ts'",
    "deploy": "pnpm --filter core-mind-worker build && alchemy deploy alchemy.run.ts",
    "destroy": "alchemy destroy alchemy.run.ts"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@distilled.cloud/cloudflare": "catalog:",
    "@effect/platform-node": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "iterate": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
