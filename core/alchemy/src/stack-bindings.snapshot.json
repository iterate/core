      "SPANS:Cloudflare.Pipelines.Stream Telemetry_spans_stream",
      "TELEMETRY_TOKEN_SOURCE:plain_text"
    ],
    "Auth": [
      "DB:Cloudflare.D1Database AuthDb",
      "ITERATE:output of AccessTeam.teamDomain, OwnerEmailProof.aud",
      "ITERATE__SIGNING_KEY:output of AuthSigningKey.text",
      "OAUTH_KV:Cloudflare.KV.Namespace AuthKv",
      "SEND_EMAIL:Cloudflare.Email.SendEmail"
    ],
    "Secrets": [
      "ACTS:Cloudflare.DurableObject (class ActsGate)",
      "APPROVALS:Cloudflare.DurableObject (class ApprovalsIndex)",
      "AUTH:Cloudflare.WorkerEntrypoint (worker Auth, entrypoint Auth)",
