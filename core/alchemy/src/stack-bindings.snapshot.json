      "CONTEXTS:Cloudflare.DurableObject (class IterateContextDurableObject)",
      "DOOR:Cloudflare.WorkerEntrypoint (worker Boundary, entrypoint Door)",
      "FILES:Cloudflare.R2.Bucket FILES",
      "IMAGES:Cloudflare.Images.Images",
      "ITERATE:plain_text",
      "ITERATE__SIGNING_KEY:output of MindSigningKey.text",
      "LOADER:Cloudflare.DynamicWorker",
      "MIND_KV:Cloudflare.KV.Namespace MindKv",
      "SANDBOX_CONTAINER:Cloudflare.DurableObject (class SandboxContainer, containers SandboxContainer)",
      "TELEMETRY_METRICS:Cloudflare.AnalyticsEngine.Dataset"
    ],
    "Boundary": [
