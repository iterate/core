{
  // Typecheck for what the base config's `include: ["src"]` never sees: the loaded-code example
  // (examples/**), the scripts that import worker code (project-seed-format.ts; tsconfig.scripts.json
  // has the other node programs) and alchemy/'s tests (state-sql.test.ts reads the stream's test
  // support, typed by workers-types). Keeps workers-types (they import src, which needs them) and
  // adds node types (they run in Node). `pnpm typecheck` runs all three configs.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "node", "vite/client"]
  },
  "include": ["examples", "scripts/project-seed*.ts", "alchemy/*.test.ts"],
  "exclude": []
}
