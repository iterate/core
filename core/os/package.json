{
  "name": "os",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "description": "OS: the Iterate platform Worker and its TanStack Start issuer pages",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "getin": "node scripts/getin.ts",
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run --configLoader runner --silent=passed-only",
    "test:watch": "vitest --configLoader runner",
    "db:generate": "sqlfu generate",
    "db:check": "rm -f .sqlfu/app.db && sqlfu migrate --yes && sqlfu check",
    "db:draft": "sqlfu draft",
    "db:migrate": "cf d1 migrations apply 00000000-0000-4000-8000-000000000000 --local --persist-to .cloudflare/state --dir src/control-plane/db/migrations",
    "deploy": "node --env-file-if-exists=.secrets scripts/deploy.ts"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@cloudflare/workers-oauth-provider": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@octokit/auth-app": "8.3.1",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "capnweb": "catalog:",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "curve25519-js": "0.0.4",
    "es-module-lexer": "^2.1.0",
    "iterate": "workspace:*",
    "lucide-react": "catalog:",
    "oauth4webapi": "catalog:",
    "pako": "catalog:",
    "postal-mime": "4.0.0",
    "posthog-js": "catalog:",
    "posthog-node": "^5.53.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sqlfu": "catalog:",
    "standardwebhooks": "catalog:",
    "sucrase": "^3.35.1",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-52b0dc0e9",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "cf": "1.0.0-beta.12",
    "esbuild": "catalog:",
    "shadcn": "catalog:",
    "trpc-cli": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
