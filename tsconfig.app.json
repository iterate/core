{
  // For a package with Worker and browser code in one program (the kernel in core/itx, the apps
  // in packages/ and internal-packages/): each one's tsconfig.json extends this.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "types": ["@cloudflare/workers-types", "node", "vite/client"],
    "jsx": "react-jsx",
    // Off for the Start apps: Start's docs warn it can leak server code into the client bundle
    // (iterate/iterate#2904).
    "verbatimModuleSyntax": false
  }
}
